# Frontend Environment Variables
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# All frontend variables must be prefixed with VITE_ to be accessible in the browser

# API Configuration
# Development: http://localhost:3000/api
# Production: https://api.csr26.it/api or your production backend URL + /api
VITE_API_URL=http://localhost:3000/api

# Stripe Configuration (Publishable Key - safe for frontend)
# Get your publishable key from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Admin Authentication
# This should match the ADMIN_SKU in backend .env
VITE_ADMIN_SKU=ADMIN-ACCESS-2026

# Optional: Frontend Development Server Port
# Default: 5173 (Vite default)
VITE_PORT=5173
